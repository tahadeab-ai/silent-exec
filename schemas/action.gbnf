# SilentExec ActionCommand & MultiStepPlan GBNF Grammar for llama.cpp
# Constrains LLM token generation strictly to valid ActionCommand or MultiStepPlan JSON

root ::= action-command | multi-step-plan

action-command ::= "{" ws "\"action\"" ws ":" ws action-val ws "," ws (target-field ws ",")? (folder-field ws ",")? (args-field ws ",")? "\"platform\"" ws ":" ws platform-val ws "," ws "\"confidence\"" ws ":" ws confidence-val ws "}"

multi-step-plan ::= "{" ws "\"steps\"" ws ":" ws "[" ws action-command (ws "," ws action-command)* ws "]" ws "}"

action-val ::= "\"open_folder\""
             | "\"open_file\""
             | "\"launch_app\""
             | "\"search_files\""
             | "\"set_volume\""
             | "\"set_brightness\""
             | "\"create_note\""
             | "\"copy_to_clipboard\""
             | "\"delete_file\""
             | "\"move_file\""
             | "\"system_power\""
             | "\"open_android_app\""
             | "\"toggle_setting\""
             | "\"send_message\""
             | "\"open_url\""
             | "\"ui_click\""
             | "\"ui_type\""
             | "\"ui_scroll\""
             | "\"ui_back\""
             | "\"ui_home\""
             | "\"done\""
             | "\"reply\""
             | "\"read_file\""
             | "\"write_file\""
             | "\"memory_save\""

platform-val ::= "\"pc\"" | "\"android\"" | "\"any\""

confidence-val ::= "1.0" | "1" | "0" ("." [0-9]+)?

target-field ::= "\"target\"" ws ":" ws json-string
folder-field ::= "\"folder\"" ws ":" ws json-string
args-field   ::= "\"args\"" ws ":" ws json-object

json-string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""

json-object ::= "{" ws (json-string ws ":" ws json-val (ws "," ws json-string ws ":" ws json-val)*)? ws "}"
json-array  ::= "[" ws (json-val (ws "," ws json-val)*)? ws "]"
json-val    ::= json-string | json-number | json-object | json-array | "true" | "false" | "null"
json-number ::= "-"? [0-9]+ ("." [0-9]+)? ([eE] [+-]? [0-9]+)?

ws ::= [ \t\n\r]*
